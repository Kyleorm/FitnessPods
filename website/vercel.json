{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/booking.html", "destination": "https://fitnesspod.clubsolution.co.uk", "permanent": false },
    { "source": "/booking", "destination": "https://fitnesspod.clubsolution.co.uk", "permanent": false },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/how-it-works.php", "destination": "/#how-it-works", "permanent": true },
    { "source": "/frequently-asked-questions.php", "destination": "/#faq", "permanent": true },
    { "source": "/contact-us.php", "destination": "/#contact", "permanent": true },
    { "source": "/take-a-tour.php", "destination": "/pods.html", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/perch/resources/important-safety-instructions-9.pdf", "destination": "/manuals/safety-instructions.pdf", "permanent": true },
    { "source": "/perch/resources/important-safety-instructions-10.pdf", "destination": "/manuals/safety-instructions.pdf", "permanent": true },
    { "source": "/perch/resources/important-safety-instructions-11.pdf", "destination": "/manuals/safety-instructions.pdf", "permanent": true },
    { "source": "/perch/resources/important-safety-instructions-12.pdf", "destination": "/manuals/safety-instructions.pdf", "permanent": true },
    { "source": "/perch/resources/:file", "destination": "/manuals/:file", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://api.web3forms.com; frame-src https://maps.google.com https://www.google.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
